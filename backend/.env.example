APP_NAME=EvidenceVault AI API
APP_VERSION=0.3.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://evidencevault_user:evidencevault_local_password@localhost:5432/evidencevault_db
SQL_ECHO=false

QDRANT_URL=http://localhost:6333
QDRANT_TIMEOUT_SECONDS=5
QDRANT_COLLECTION_NAME=evidencevault_chunks
QDRANT_VECTOR_DISTANCE=Cosine

UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_MB=20
UPLOAD_CHUNK_SIZE_BYTES=1048576

EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true
EMBEDDING_QUERY_INSTRUCTION=Represent this sentence for searching relevant passages:

# LLM Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60